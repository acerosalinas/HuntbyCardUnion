# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-only, NEVER expose with a NEXT_PUBLIC_ prefix.
# Used by admin Server Actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin accounts (multi-admin, each with their own email/password) are
# managed through Supabase Auth - no env var needed here. See README for how
# to bootstrap the first Super Admin account.

# Buyer accounts also use Supabase Auth (self-signup at /account/signup) -
# no env var needed for that either.

# Resend (resend.com) - server-only, NEVER expose with a NEXT_PUBLIC_ prefix.
# Used to email buyers when admin confirms their payment/order. Until you
# verify a sending domain in Resend, it can only deliver to the account
# owner's own email address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Card Union <onboarding@resend.dev>

# Optional: ISO timestamp for the Live Drop Banner countdown. Omit/blank to
# hide the banner.
NEXT_PUBLIC_NEXT_DROP_AT=

# Optional, testing only: a SEPARATE Supabase project (same schema.sql) used
# by tests/integration/concurrency.test.ts. Never point these at production -
# the test creates and deletes a real card. Leave unset to skip that test.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
